API_TOKEN=your_telegram_bot_token
ADMIN_ID=123456789
BOT_NAME=your_bot_username
LOG_LEVEL=INFO

# Optional proxy for server-side access to Telegram API
HTTP_PROXY=http://user:password@host:port
HTTPS_PROXY=http://user:password@host:port

# Web dashboard (python -m webapp.app), usually kept in a separate .env.web
WEB_BASE_PATH=/residentchatbot
WEB_BIND_HOST=127.0.0.1
WEB_BIND_PORT=8080
WEB_SERVICE_NAME=residentchatbot.service
WEB_ADMIN_USER=residentchatbot
WEB_ADMIN_PASSWORD=change_me_to_a_long_random_password
